{
  "name": "tegano-blog3",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio site for Tegano Masinde (static HTML, CSS and JavaScript)",
  "scripts": {
    "serve": "http-server . -p 4173 -c-1",
    "lint:html": "html-validate index.html report.html \"cases/*.html\" \"blog/*.html\"",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test": "npm run lint:html && npm run test:static && npm run test:unit && npm run test:e2e",
    "build": "bash scripts/build.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "html-validate": "^9.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
